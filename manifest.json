{
  "manifest_version": 3,
  "name": "TabSnapshot - Workspace Manager",
  "version": "1.0.0",
  "description": "Capture, save, and restore complex multi-window browser workspaces with tab groups in one click.",
  "permissions": [
    "tabs",
    "storage",
    "windows",
    "tabGroups",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}